  <div class="section-eyebrow"><div class="eyebrow-dot"></div><div class="eyebrow-text">Layanan Populer</div></div>
  <h1 class="section-title">List All Item</h1>

  <div class="search-wrap">
    <span class="search-icon"><svg width="15" height="15" viewBox="0 0 15 15" fill="none"><circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10 10l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>
    <input type="text" id="searchInput" class="search-input" placeholder="Cari layanan..." oninput="filterProducts()">
  </div>

  <div class="cats">
    <button class="cat-btn active" data-cat="ALL" onclick="setCategory(this)">Semua</button>
    <button class="cat-btn" data-cat="GMAIL" onclick="setCategory(this)">
      <svg width="11" height="11" viewBox="0 0 11 11" fill="none"><rect x="1" y="2" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="1.2"/><path d="M1 3.5l4.5 3L10 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
      Gmail
    </button>
    <button class="cat-btn" data-cat="WEB" onclick="setCategory(this)">
      <svg width="11" height="11" viewBox="0 0 11 11" fill="none"><circle cx="5.5" cy="5.5" r="4" stroke="currentColor" stroke-width="1.2"/><ellipse cx="5.5" cy="5.5" rx="2" ry="4" stroke="currentColor" stroke-width="1.2"/><path d="M1.5 5.5h8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
      Apk
    </button>
    <button class="cat-btn cat-riwayat" onclick="bukaRiwayat()">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
      Riwayat Trx
    </button>
  </div>

  <div class="product-grid" id="productGrid"></div>
</main>

<footer><p>© <strong>VANO</strong><span class="brand"> NESIA</span> 2026 — Trusted &amp; Open 24 Jam</p></footer>

<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
const products=[
  {id:"jasteb",name:"Order Jasteb",desc:"Layanan Jasteb Kirim via Gmail",platform:"GMAIL",icon:"https://apkunchek.fun/assets/img/gmail.png",badge:"POPULAR",url:"https://apkunchek.fun/check-produk.php?type=jasteb"},
  {id:"key",name:"Order Key Apk",desc:"Untuk login aplikasi unchek milik kami",platform:"WEB",icon:"https://apkunchek.fun/assets/img/logoku.png",badge:"HOT",url:"https://apkunchek.fun/check-produk.php?type=key"}
];
const platformStyles={GMAIL:{tagClass:"tag-gmail",tagLabel:"Via Gmail",cardClass:"gmail-card"},WEB:{tagClass:"tag-web",tagLabel:"Via Apk",cardClass:"web-card"}};
const badgeStyles={HOT:"badge-hot",POPULAR:"badge-pop",REKOMENDASI:"badge-new"};
let activeCategory="ALL";

function renderProducts(list){
  const grid=document.getElementById("productGrid");
  if(list.length===0){grid.innerHTML='<div class="empty"><div class="empty-icon">🔍</div><div class="empty-text">Produk tidak ditemukan</div><button class="empty-reset" onclick="resetFilter()">Reset filter</button></div>';return;}
  grid.innerHTML=list.map((p,i)=>{
    const st=platformStyles[p.platform];
    const delay=i*80;
    const badgeHtml=p.badge?`<span class="card-badge ${badgeStyles[p.badge]}">${p.badge}</span>`:"";
    return `<div class="product-card ${st.cardClass}" style="animation-delay:${delay}ms">${badgeHtml}<div class="card-thumb"><img src="${p.icon}" alt="${p.name}" onerror="this.parentElement.innerHTML='<svg width=\'32\' height=\'32\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'#a78bfa\' stroke-width=\'1.5\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><rect x=\'2\' y=\'7\' width=\'20\' height=\'14\' rx=\'2\'/><path d=\'M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2\'/></svg>'"></div><div><span class="card-platform-tag ${st.tagClass}">${st.tagLabel}</span><div class="card-name">${p.name}</div><div class="card-desc">${p.desc}</div></div><a href="${p.url}" class="card-btn"><svg width="11" height="11" viewBox="0 0 11 11" fill="none"><path d="M1.5 2h6a1 1 0 011 1v5a1 1 0 01-1 1h-6a1 1 0 01-1-1V3a1 1 0 011-1z" stroke="white" stroke-width="1.2"/><path d="M3 2V1.5M7 2V1.5M1 4.5h8" stroke="white" stroke-width="1.2" stroke-linecap="round"/></svg>Beli Sekarang</a></div>`;
  }).join("");
}
function filterProducts(){
  const s=document.getElementById("searchInput").value.toLowerCase();
  renderProducts(products.filter(p=>{
    const m=p.name.toLowerCase().includes(s)||p.desc.toLowerCase().includes(s);
    return m&&(activeCategory==="ALL"||p.platform===activeCategory);
  }));
}
function setCategory(btn){document.querySelectorAll(".cat-btn").forEach(b=>b.classList.remove("active"));btn.classList.add("active");activeCategory=btn.dataset.cat;filterProducts();}
function resetFilter(){document.getElementById("searchInput").value="";activeCategory="ALL";document.querySelectorAll(".cat-btn").forEach(b=>b.classList.remove("active"));document.querySelector('[data-cat="ALL"]').classList.add("active");renderProducts(products);}
function closePopup(){document.getElementById("popupOverlay").classList.remove("active");}
async function doLogout(){await fetch('api/auth.php?action=logout',{method:'POST'}).catch(()=>{});window.location.reload();}
const IS_LOGGED_IN = false;
function bukaRiwayat(){
  if(IS_LOGGED_IN){window.location.href='lacak.php';return;}
  document.getElementById('loginModal').classList.add('active');
  document.body.style.overflow='hidden';
}
function tutupLoginModal(){
  document.getElementById('loginModal').classList.remove('active');
  document.body.style.overflow='';
}
window.addEventListener("load",function(){const pre=document.getElementById("preloader");setTimeout(()=>{pre.classList.add("hide");setTimeout(()=>pre.style.display="none",500)},900);});
setTimeout(()=>document.getElementById("popupOverlay").classList.add("active"),1500);
renderProducts(products);
</script>
</body>
</html>
